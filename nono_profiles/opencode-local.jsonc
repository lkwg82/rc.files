{
  // see https://nono.sh/docs/cli/features/profile-authoring
  "$schema": "./nono-profile.schema.json",
  "extends": [
    "nolabs-ai/opencode",
    "macosx-swift-local"
  ],
  "meta": {
    "name": "opencode-local",
    "version": "1.0.0",
    "description": "Runtime-discovered path additions for opencode",
    "author": null
  },
  "groups": {
    // see https://github.com/nolabs-ai/nono-packs/blob/main/opencode/policy.json
    "include": [
      "go_runtime",
      "python_runtime"
    ]
  },
  "filesystem": {
    "allow": [
      "~/.cache",
      "~/.terraform.d",  // plugin provider cache
      "."
    ],
    "read": [
      "~/.sdkman/candidates/java/current",
      "~/.sdkman/candidates/mvnd/current",
      "~/.claude",
      "~/.config",
      "~/.copilot/skills",
      "~/ghorg",
      "~/bin",
      "~/IdeaProjects",
      "~/development",
      "~/.bashrc.d"
    ],
    "read_file": [
      "~/.claude/CLAUDE.md",
      "~/.copilot/copilot-instructions.md",
      "~/global_.gitignore",
      "~/.bashrc",
      "~/.tofurc",
      "~/.inputrc",
      "~/.vimrc"
    ],
    "bypass_protection": [
      "~/.bash_profile",
      "~/.terraform.d"
    ],
    "suppress_save_prompt": [
      "/Users",
      "~/",
      "/System",
      "/Library/Keychains",
      "/usr"
    ],
    "unix_socket_dir": [
      "~/.cache/opencode/tmp"
    ]
  },
  "network": {
    "network_profile": "opencode",
    "allow_domain": [
      "copilot-api.deutschebahn.ghe.com",
      "127.0.0.1",
      // for mcp proxy
      "bahnhub.tech.rz.db.de"
      // artifactory
    ],
    "open_port": [
      0
    ],
    "open_port_range": [
      [
        // needed for opencode --hostname 127.0.0.1 --port 4097
        4096,
        4099
      ]
    ]
  }
}
