{
  // see https://nono.sh/docs/cli/features/profile-authoring
  "$schema": "./nono-profile.schema.json",
  "extends": [
    "opencode"
  ],
  "meta": {
    "name": "opencode-local",
    "version": "1.0.0",
    "description": "Runtime-discovered path additions for opencode",
    "author": null
  },
  "groups": {
    // see https://github.com/nolabs-ai/nono-packs/blob/main/opencode/policy.json
    "include": [
      "go_runtime",
      "python_runtime"
    ]
  },
  "filesystem": {
    "allow": [
      "~/.cache",
      "."
    ],
    "read": [
      "~/.sdkman/candidates/java/current",
      "~/.sdkman/candidates/mvnd/current",
      "~/.claude",
      "~/.config",
      "~/.copilot/skills",
      "~/ghorg",
      "~/bin",
      "~/IdeaProjects",
      "~/development",
      "~/.bashrc.d"
    ],
    "read_file": [
      "~/.claude/CLAUDE.md",
      "~/.copilot/copilot-instructions.md",
      "~/global_.gitignore",
      "~/.bashrc"
    ],
    "bypass_protection": [
      "~/.bash_profile"
    ],
    "suppress_save_prompt": [
      "/Users",
      "~/",
      "/System",
      "/Library/Keychains",
      "/usr"
    ]
  },
  "network": {
    "network_profile": "opencode",
    "allow_domain": [
      "copilot-api.deutschebahn.ghe.com",
      // for upstream mcp proxy 1/2
      "127.0.0.1"
    ],
    "open_port": [ 0 ], // only for macosx
      // for upstream mcp proxy 2/2
//      8080
//    ],
    "open_port_range": [
      [
        // needed for opencode --hostname 127.0.0.1 --port 4097
        4096,
        4099
      ]
    ]
  }
}
